# ============================================================
# Personal Trainer — Variáveis de Ambiente (Exemplo)
# Copie para .env e preencha os segredos antes de rodar.
# ============================================================

# Banco de dados PostgreSQL (Prisma)
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/personal_trainer?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/personal_trainer?connect_timeout=15"

# URL pública da aplicação (usada em callbacks OAuth e links .ics)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Autenticação & Sessão (Obrigatório em produção!)
# Pelo menos um segredo forte deve ser configurado para proteger rotas /api/* e UI via /login.
APP_PASSWORD=""
SESSION_SECRET=""
INTERNAL_API_SECRET=""
CRON_SECRET=""
ECOSYSTEM_SYNC_SECRET=""

# Provedor de IA (OpenRouter)
OPENROUTER_API_KEY=""
OPENROUTER_PRIMARY_MODEL=""
OPENROUTER_FALLBACK_MODELS=""

# Integração Strava (OAuth2 & Webhook)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_VERIFY_TOKEN=""
STRAVA_WEBHOOK_SUBSCRIPTION_ID=""
STRAVA_ATHLETE_ID=""
STRAVA_DEFAULT_ACCESS_TOKEN=""
STRAVA_DEFAULT_REFRESH_TOKEN=""
STRAVA_DEFAULT_EXPIRES_AT=""
STRAVA_DEFAULT_ATHLETE_ID=""

# Integração Meu Rastreador Metabólico (Anti-SSRF allowlist)
METABOLIC_TRACKER_URL=""
METABOLIC_ALLOWED_HOSTS=""
